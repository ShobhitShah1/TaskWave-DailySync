<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#222425">

    <!-- Top Content Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="80dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/ic_alarm"
            android:tint="#B4C2FF" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFF"
            android:textSize="80sp"
            android:fontFamily="@font/clashgrotesk_bold"
            android:includeFontPadding="false" />
            
        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="a"
            android:textColor="#8E9091"
            android:textSize="20sp"
            android:fontFamily="@font/clashgrotesk_bold"
            android:textAllCaps="true"
            android:layout_marginBottom="32dp" />

        <TextView
            android:id="@+id/alarmTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Alarm"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:fontFamily="@font/clashgrotesk_bold"
            android:layout_marginBottom="16dp"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/alarmBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Lorem Ipsum is simply dummy text of the printing and typesetting industry."
            android:textColor="#8E9091"
            android:textSize="16sp"
            android:fontFamily="@font/clashgrotesk_medium"
            android:textAlignment="center"
            android:lineSpacingExtra="4dp"
            android:paddingHorizontal="20dp" />

    </LinearLayout>

    <!-- Bottom Actions Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="32dp"
        android:layout_marginBottom="40dp">

        <!-- Snooze Button Group -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="40dp">

            <ImageButton
                android:id="@+id/snoozeButton"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:background="@drawable/bg_snooze_circle"
                android:src="@drawable/ic_snooze"
                android:scaleType="centerInside"
                android:padding="20dp"
                android:tint="#8E9091"
                android:contentDescription="Snooze" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Snooze"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/clashgrotesk_bold"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Dismiss Button Group -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/dismissButton"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:background="@drawable/bg_dismiss_circle"
                android:src="@drawable/ic_dismiss"
                android:scaleType="centerInside"
                android:padding="20dp"
                android:tint="#FFFFFF"
                android:contentDescription="Dismiss" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dismiss"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/clashgrotesk_bold"
                android:layout_marginTop="12dp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
